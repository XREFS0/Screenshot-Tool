<Window x:Class="MASA.Screenshot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASA Screenshot — Professional Screen Capture"
        Height="540" Width="720"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- Capture Modes Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Options & Quick Actions -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="MASA Screenshot" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="High-Performance Windows Screen Capture &amp; Annotation Suite" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="📜 History" Style="{StaticResource ModernButton}" Margin="4,0" Command="{Binding OpenHistoryCommand}"/>
                <Button Content="⚙️ Settings" Style="{StaticResource ModernButton}" Margin="4,0" Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Primary Capture Buttons -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Selected Area -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Selected Area" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select rectangular region" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,10"/>
                    <Button Content="Capture Area" Style="{StaticResource AccentButton}" Command="{Binding StartCaptureCommand}" CommandParameter="SelectedArea"/>
                </StackPanel>
            </Border>

            <!-- Full Screen -->
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🖥️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Full Screen" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Capture entire desktop" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,10"/>
                    <Button Content="Capture Full" Style="{StaticResource ModernButton}" Command="{Binding StartCaptureCommand}" CommandParameter="FullScreen"/>
                </StackPanel>
            </Border>

            <!-- Active Window -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🪟" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Active Window" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Capture focused window" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,10"/>
                    <Button Content="Capture Window" Style="{StaticResource ModernButton}" Command="{Binding StartCaptureCommand}" CommandParameter="ActiveWindow"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quick Capture Configuration Card -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Capture Options" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                        <TextBlock Text="⏱️ Delay:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox SelectedValue="{Binding DelaySeconds}" SelectedValuePath="Tag" Width="100" Height="28">
                            <ComboBoxItem Content="None (0s)" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="3 Seconds" Tag="3"/>
                            <ComboBoxItem Content="5 Seconds" Tag="5"/>
                            <ComboBoxItem Content="10 Seconds" Tag="10"/>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="🖱️ Include Cursor" IsChecked="{Binding IncludeCursor}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,20,8"/>
                    <CheckBox Content="✨ Window Shadow" IsChecked="{Binding IncludeShadow}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,20,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource ToolbarBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Win + Shift + S / PrintScreen" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
