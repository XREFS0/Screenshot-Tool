<Window x:Class="MASA.Screenshot.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Canvas containing full screenshot background and cutout overlay -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- Dimming overlay -->
        <Canvas x:Name="OverlayCanvas" Background="#55000000">
            <!-- Cutout / Selection Border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="#0078D4"
                    BorderThickness="2"
                    Background="Transparent"
                    Visibility="Collapsed">
                <Grid>
                    <!-- Dimension Badge -->
                    <Border Background="#CC1E1E1E"
                            CornerRadius="4"
                            Padding="6,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,-28">
                        <TextBlock x:Name="DimensionText"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="0 × 0 px"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Floating Quick Toolbar after selection -->
            <Border x:Name="SelectionToolbar"
                    Background="#EE252525"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Content="📋 Copy" Style="{StaticResource ModernButton}" Margin="2,0" Click="CopyButton_Click"/>
                    <Button Content="💾 Save" Style="{StaticResource ModernButton}" Margin="2,0" Click="SaveButton_Click"/>
                    <Button Content="✏️ Edit" Style="{StaticResource AccentButton}" Margin="2,0" Click="EditButton_Click"/>
                    <Button Content="❌ Cancel" Style="{StaticResource ModernButton}" Margin="2,0" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Magnifier & Color Picker HUD -->
        <Border x:Name="MagnifierHud"
                Width="150"
                Height="150"
                CornerRadius="8"
                BorderBrush="#0078D4"
                BorderThickness="2"
                Background="#EE1A1A1A"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Grid>
                <Image x:Name="MagnifierImage" Stretch="UniformToFill" Margin="4,4,4,30"/>
                <!-- Crosshair center -->
                <Line X1="0" Y1="58" X2="142" Y2="58" Stroke="#AAFF0000" StrokeThickness="1"/>
                <Line X1="71" Y1="0" X2="71" Y2="116" Stroke="#AAFF0000" StrokeThickness="1"/>
                <!-- Bottom Info -->
                <TextBlock x:Name="MagnifierColorText"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="#FFFFFF | (0,0)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
