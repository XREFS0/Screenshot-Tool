<Window x:Class="MASA.Screenshot.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASA Screenshot — Capture History"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Items Grid -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Capture History" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Browse, preview, edit and export your past captures" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="🗑️ Clear All History" Style="{StaticResource ModernButton}" Command="{Binding ClearAllHistoryCommand}"/>
            </StackPanel>
        </Grid>

        <!-- History ListView -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="210" Height="230"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="8"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="120"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Thumbnail -->
                            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="4" ClipToBounds="True">
                                <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ResolutionText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Actions Row -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="📋" ToolTip="Copy to Clipboard" Style="{StaticResource ModernButton}" Padding="6,2" Margin="2,0"
                                        Command="{Binding DataContext.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✏️" ToolTip="Edit Annotation" Style="{StaticResource ModernButton}" Padding="6,2" Margin="2,0"
                                        Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="📁" ToolTip="Show in Explorer" Style="{StaticResource ModernButton}" Padding="6,2" Margin="2,0"
                                        Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="❌" ToolTip="Delete" Style="{StaticResource ModernButton}" Padding="6,2" Margin="2,0"
                                        Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Status -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
